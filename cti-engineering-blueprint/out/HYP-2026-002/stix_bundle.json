    {
      "type": "report",
      "id": "report--46609c17-8724-5055-a19e-e317c72d7c33",
      "name": "HYP-2026-002: Indirect prompt injection against an internal RAG assistant to leak customer or internal data",
      "description": "An adversary who can place content in a source our internal RAG assistant indexes (shared drive, wiki, inbound email, vendor portal) can embed instructions that cause the assistant to reveal data from other retrieved documents or call tools outside the user's intent. If true, we should see retrieved chunks containing instruction-like text, model outputs containing data classes the requesting user is not entitled to, and tool calls that do not trace to the user's prompt.\n",
      "report_types": [
        "attack-pattern"
      ],
