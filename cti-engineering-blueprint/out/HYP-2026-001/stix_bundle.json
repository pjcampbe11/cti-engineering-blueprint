    {
      "type": "report",
      "id": "report--57ed54b2-5b45-55af-a564-a308c1f79942",
      "name": "HYP-2026-001: Help-desk social engineering leading to identity provider takeover and RMM persistence",
      "description": "A financially motivated intrusion set using Scattered Spider-style tradecraft is likely to call our IT service desk impersonating employees, obtain an MFA reset, register an attacker-controlled MFA device, and install a commercial remote monitoring and management (RMM) tool for persistence. If that is true, we should see (a) MFA device registrations shortly after help-desk resets, (b) MFA push bursts against the same identities, and (c) RMM binaries that are not on our approved software list executing on endpoints.\n",
      "report_types": [
        "threat-actor"
      ],
