# Secrets come from the environment (inject from a vault / CI secret store). Never commit a filled copy.

# --- TIP: Anomali ThreatStream
TS_BASE_URL=https://api.threatstream.com
TS_USERNAME=
TS_API_KEY=
# --- Feeds
ABUSECH_AUTH_KEY=
VT_API_KEY=
TAXII_USER=
TAXII_PASSWORD=
# --- SIEM: Splunk HEC
SPLUNK_HEC_URL=https://splunk.example.internal:8088
SPLUNK_HEC_TOKEN=
# --- EDR: CrowdStrike Falcon (API client scopes: Alerts R, Hosts R, NGSIEM R+W)
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
FALCON_BASE_URL=auto
CS_NGSIEM_REPO=investigate_view
# --- EDR: SentinelOne (Mgmt API token + SDL Log Read key)
S1_MGMT_URL=https://yourtenant.sentinelone.net
S1_API_TOKEN=
S1_SDL_URL=https://xdr.us1.sentinelone.net
S1_SDL_KEY=
# --- EDR: Carbon Black Cloud (token = API_SECRET/API_ID)
CBC_URL=https://defense.conferdeploy.net
CBC_TOKEN=
CBC_ORG_KEY=
# --- EDR: Microsoft Defender via Graph (app permission ThreatHunting.Read.All)
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
# --- Cloud runtime: Wiz (service account scopes: read:detections, read:cloud_events_sensor, read:issues, read:resources)
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_URL=https://api.us1.app.wiz.io/graphql
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# --- Optional
REQUESTS_CA_BUNDLE=
FABRIC_SERVICE_ACCOUNT=svc-cti-fabric
